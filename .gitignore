# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.pytest_cache/

# Model checkpoints (large binary files - download via Colab)
backend/checkpoints/*
# ...except the fitted calibration temperature: tiny, and without it the
# ensemble silently falls back to an uncalibrated T=1.0.
!backend/checkpoints/calibration.json
# ...and per-category eval results: tiny JSON, and without these tracked,
# "we improved X -> Y" claims aren't diffable against a prior commit.
!backend/checkpoints/*_by_category.json
!backend/checkpoints/*.metrics.json

# Dataset (download via Kaggle)
data/

# Generated static files (heatmaps, diff maps)
backend/static/*.jpg
backend/static/*.png
backend/static/*.webp

# Detection history database
backend/history.db

# Frontend
frontend/node_modules/
frontend/dist/

# Environment
.env
.env.local

# IDE
.vscode/
.idea/
*.suo
*.user
.claude/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
